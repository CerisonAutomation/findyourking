# ============================================================
# ZENITH DATING PLATFORM — Environment Variables
# Copy to .env.local — NEVER COMMIT .env.local
# ============================================================

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Get from: supabase.com > project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================================
# AI & LLM CONFIGURATION
# =====================================================
# OpenRouter (free OSS models — llama3, mistral, gemma, etc.)
# Get key at: openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Alternative AI Services
OPENAI_API_KEY=your-openai-api-key
VITE_EMERGENT_LLM_KEY=your_emergent_llm_key
VITE_PICOVOICE_ACCESS_KEY=your_picovoice_access_key

# =====================================================
# P2P & WEBRTC CONFIGURATION
# =====================================================
# Trystero (room namespace — your app's unique ID)
NEXT_PUBLIC_TRYSTERO_APP_ID=zenith-dating-platform-v1
NEXT_PUBLIC_TRYSTERO_STRATEGY=nostr

# TURN server (optional self-hosted coturn, or use Metered free tier)
NEXT_PUBLIC_TURN_URL=turn:global.relay.metered.ca:80
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# WebTorrent Tracker
WEBTORRENT_TRACKER_URL=your_tracker_url

# =====================================================
# MAPPING & LOCATION SERVICES
# =====================================================
# MapLibre / Map tiles (free: protomaps, maptiler free tier)
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key

# =====================================================
# AUTHENTICATION CONFIGURATION
# =====================================================
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_MAGIC_LINK_CALLBACK_URL=http://localhost:3000/auth/callback

# =====================================================
# API CONFIGURATION
# =====================================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:5000

# =====================================================
# STRIPE CONFIGURATION
# =====================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# =====================================================
# EMAIL & NOTIFICATIONS
# =====================================================
# SendGrid (for email notifications)
SENDGRID_API_KEY=your_sendgrid_key

# Push Notifications (Firebase Cloud Messaging - optional)
NEXT_PUBLIC_FCM_VAPID_KEY=your-fcm-vapid-key

# =====================================================
# ANALYTICS & MONITORING
# =====================================================
# Sentry (for error tracking)
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Google Analytics
NEXT_PUBLIC_GA_ID=your-google-analytics-id
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# =====================================================
# FEATURE FLAGS
# =====================================================
VITE_ENABLE_AI_MATCHING=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_STORYBOOK=true
VITE_ENABLE_QUICKSHARE=true
VITE_ENABLE_VOICE_COMMANDS=true

# =====================================================
# DEVELOPMENT CONFIGURATION
# =====================================================
NODE_ENV=development
VITE_DEV_MODE=true
VITE_LOG_LEVEL=debug
VITE_MOCK_API=false

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Zenith Dating Platform

# Database (Supabase manages this, but for reference)
DATABASE_URL=your-database-url