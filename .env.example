# ============================================================================
# FindYourKing - Environment Variables Template
# ============================================================================
# IMPORTANT: Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git (it's in .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/[your-project]/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (NEVER expose to client, server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# Stream Chat & Video Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Get these from: https://dashboard.getstream.io/app/[your-app]/

# Stream API Key (safe for client-side use)
NEXT_PUBLIC_STREAM_API_KEY=your-stream-api-key

# Stream API Secret (NEVER expose to client, server-side only)
STREAM_API_SECRET=your-stream-api-secret

# ============================================================================
# Stripe Configuration (OPTIONAL - for payment features)
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys

# Stripe Publishable Key (safe for client-side use)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Secret Key (NEVER expose to client, server-side only)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (from Webhooks dashboard)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# Stripe Product & Price IDs
# ============================================================================
# Create these in your Stripe Dashboard: https://dashboard.stripe.com/products

# FREE TIER
STRIPE_PRODUCT_FREE=prod_your_free_product_id
STRIPE_PRICE_FREE=price_your_free_price_id

# BRONZE TIER
STRIPE_PRODUCT_BRONZE=prod_your_bronze_product_id
STRIPE_PRICE_BRONZE=price_your_bronze_price_id

# SILVER TIER
STRIPE_PRODUCT_SILVER=prod_your_silver_product_id
STRIPE_PRICE_SILVER=price_your_silver_price_id

# GOLD TIER
STRIPE_PRODUCT_GOLD=prod_your_gold_product_id
STRIPE_PRICE_GOLD=price_your_gold_price_id

# ============================================================================
# Stripe Configuration Options
# ============================================================================
STRIPE_API_VERSION=2025-11-17.clover
NEXT_PUBLIC_CURRENCY=EUR

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------

# Application URL (for OAuth redirects and auth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment (development, production, test)
NODE_ENV=development

# ----------------------------------------------------------------------------
# Security Configuration (PRODUCTION REQUIRED)
# ----------------------------------------------------------------------------

# CSRF Protection Secret (generate with: openssl rand -hex 32)
CSRF_SECRET=your-csrf-secret-key-here-minimum-32-chars

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-session-secret-key-here-minimum-32-chars

# Encryption Key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-encryption-key-here-minimum-32-chars

# JWT Secrets (if using custom JWT implementation)
# JWT_SECRET=your-jwt-secret-here
# JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# ----------------------------------------------------------------------------
# Rate Limiting Configuration (PRODUCTION TUNING)
# ----------------------------------------------------------------------------

# Rate limit for login attempts (per IP)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300

# Rate limit for signup attempts (per IP)
RATE_LIMIT_SIGNUP_MAX=3
RATE_LIMIT_SIGNUP_WINDOW=3600

# Rate limit for password reset (per IP)
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=3600

# Rate limit for API requests (per user/IP)
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=60

# ----------------------------------------------------------------------------
# Optional: Error Monitoring (Sentry)
# ----------------------------------------------------------------------------
# Get these from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/

# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ----------------------------------------------------------------------------
# Optional: Analytics
# ----------------------------------------------------------------------------

# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# ----------------------------------------------------------------------------
# SECURITY NOTES & PRODUCTION CHECKLIST
# ----------------------------------------------------------------------------
#
# CRITICAL: Never commit actual secrets to git
# ✓ 1. NEVER commit this file with real values
# ✓ 2. NEVER expose SUPABASE_SERVICE_ROLE_KEY to client-side code
# ✓ 3. NEVER expose STREAM_API_SECRET to client-side code
# ✓ 4. NEVER expose STRIPE_SECRET_KEY to client-side code
# ✓ 5. Generate strong secrets for CSRF_SECRET, SESSION_SECRET, ENCRYPTION_KEY
# ✓ 6. Use different secrets for development and production
#
# Production Deployment (Vercel):
# ✓ 1. Add all environment variables in Settings → Environment Variables
# ✓ 2. Set NODE_ENV=production for production deployments
# ✓ 3. Use production Stripe keys (pk_live_*, sk_live_*)
# ✓ 4. Set NEXT_PUBLIC_SITE_URL to your production domain
# ✓ 5. Configure rate limiting based on expected traffic
# ✓ 6. Enable Supabase email verification in production
# ✓ 7. Set up Stripe webhooks with production URL
# ✓ 8. Test all auth flows in production environment
# ✓ 9. Enable HTTPS and HSTS headers (automatic on Vercel)
# ✓ 10. Review CSP headers in next.config.ts for production domains
#
# Security Best Practices:
# • Rotate secrets periodically (every 90 days recommended)
# • Use environment-specific secrets (dev vs staging vs prod)
# • Monitor security logs for suspicious activity
# • Keep dependencies updated (npm audit, dependabot)
# • Enable MFA for all service accounts (Supabase, Stripe, etc.)
# • Implement proper backup procedures for Supabase
# • Set up monitoring and alerting (Sentry, Vercel Analytics)
#
# Password Policy Enforcement:
# • Minimum 8 characters
# • Must contain uppercase and lowercase letters
# • Must contain number or special character
# • Blocks common passwords (password, 123456, etc.)
# • Per OWASP and NIST 800-63B standards
#
# Rate Limiting Applied To:
# • Login attempts: 5 per 5 minutes per IP
# • Signup attempts: 3 per hour per IP
# • Password reset: 3 per hour per IP
# • API requests: 100 per minute per user/IP
#
# CSRF Protection:
# • Double-submit cookie pattern
# • Origin header verification
# • Custom CSRF tokens for state-changing operations
# • Per OWASP CSRF Prevention Cheat Sheet
#
# For questions or issues, see:
# • Supabase Auth Docs: https://supabase.com/docs/guides/auth
# • OWASP Top 10: https://owasp.org/www-project-top-ten/
# • NIST 800-63B: https://pages.nist.gov/800-63-3/sp800-63b.html
# ============================================================================
