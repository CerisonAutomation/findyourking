{
  "name": "zenith-dating-platform",
  "version": "2.0.0",
  "description": "Enterprise-grade privacy-first P2P dating platform with Jazz CRDT sync",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "env:validate": "node scripts/validate-env.js .env.local",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "mobile:sync": "next build && cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "deploy:prod": "next build && vercel --prod",
    "security:audit": "npm audit --audit-level high",
    "perf:analyze": "next build && npx @next/bundle-analyzer",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
