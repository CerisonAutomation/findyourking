{
  "name": "findyourking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=test-results.xml",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "turbo": "turbo",
    "turbo:build": "turbo run build",
    "turbo:lint": "turbo run lint",
    "turbo:test": "turbo run test",
    "docker:build": "docker build -t findyourking:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local findyourking:latest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "db:docker": "./scripts/push-to-docker.sh",
    "db:supabase": "./scripts/push-to-supabase.sh",
    "db:init": "POSTGRES_PORT=5433 docker-compose up -d postgres && sleep 5 && pnpm run db:docker",
    "db:pgadmin": "docker-compose --profile tools up pgadmin"
  },
