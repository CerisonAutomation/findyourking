{
  "name": "find-your-king",
  "version": "2.0.0",
  "description": "Professional AI-powered dating platform with enterprise security and advanced features",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "env:validate": "node scripts/validate-env.js .env.local",
