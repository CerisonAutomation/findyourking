/* Import system fonts for better performance */
@import url('https://rsms.me/inter/inter.css');

/* stylelint-disable at-rule-no-unknown */
/* Tailwind directives are processed by PostCSS/Tailwind; disable the linter for these at-rules */
@tailwind base;
@tailwind components;
@tailwind utilities;
/* stylelint-enable at-rule-no-unknown */

@layer base {
  html {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-feature-settings: "rlig" 1, "calt" 1;
  }

  :root {
    /* Light Mode - WCAG AA Enhanced Contrast + Romantic Theme */
    --background: 0 0% 100%;
    --foreground: 222 47% 11%; /* Darker for better contrast */
    --card: 0 0% 100%;
    --card-foreground: 222 47% 11%;
    --popover: 0 0% 100%;
    --popover-foreground: 222 47% 11%;
    --primary: 346 84% 61%; /* Romantic rose/pink */
    --primary-foreground: 0 0% 100%;
    --secondary: 210 40% 96.1%;
    --secondary-foreground: 222 47% 11%;
    --muted: 210 40% 96.1%;
    --muted-foreground: 215 16% 47%; /* Improved contrast */
    --accent: 20 91% 57%; /* Warm orange accent */
    --accent-foreground: 0 0% 100%;
    --destructive: 0 72% 51%; /* Better red contrast */
    --destructive-foreground: 0 0% 100%;
    --border: 214 32% 91%;
    --input: 214 32% 91%;
    --ring: 346 84% 61%;
    --chart-1: 12 76% 61%;
    --chart-2: 173 58% 39%;
    --chart-3: 197 37% 24%;
    --chart-4: 43 74% 66%;
    --chart-5: 27 87% 67%;
    --radius: 0.5rem;
    
    /* Opulent Design System - Romantic Gradients */
    --gradient-hero: linear-gradient(135deg, hsl(346 84% 61%) 0%, hsl(20 91% 57%) 100%);
    --gradient-hero-dark: linear-gradient(135deg, hsl(346 77% 37%) 0%, hsl(20 76% 35%) 100%);
    --gradient-card: linear-gradient(145deg, hsl(0 0% 100%) 0%, hsl(0 0% 98%) 100%);
    --glass-bg: rgba(255, 255, 255, 0.7);
    --glass-border: rgba(255, 255, 255, 0.2);
  }
  
  .dark {
    /* Dark Mode - WCAG AA Enhanced Contrast + Romantic Theme */
    --background: 222 47% 11%;
    --foreground: 210 40% 98%;
    --card: 222 47% 13%;
    --card-foreground: 210 40% 98%;
    --popover: 222 47% 13%;
    --popover-foreground: 210 40% 98%;
    --primary: 346 90% 70%; /* Lighter pink for dark mode */
    --primary-foreground: 222 47% 11%;
    --secondary: 217 33% 17%;
    --secondary-foreground: 210 40% 98%;
    --muted: 217 33% 17%;
    --muted-foreground: 215 20% 65%; /* Better contrast */
    --accent: 20 95% 63%; /* Lighter orange for dark */
    --accent-foreground: 222 47% 11%;
    --destructive: 0 63% 50%; /* Adjusted for dark mode */
    --destructive-foreground: 210 40% 98%;
    --border: 217 33% 17%;
    --input: 217 33% 17%;
    --ring: 346 90% 70%;
    --chart-1: 220 70% 50%;
    --chart-2: 160 60% 45%;
    --chart-3: 30 80% 55%;
    --chart-4: 280 65% 60%;
    --chart-5: 340 75% 55%;
    
    /* Opulent Design System - Dark Mode Romantic Gradients */
    --gradient-hero: linear-gradient(135deg, hsl(346 90% 70%) 0%, hsl(20 95% 63%) 100%);
    --gradient-hero-dark: linear-gradient(135deg, hsl(346 77% 37%) 0%, hsl(20 76% 35%) 100%);
    --gradient-card: linear-gradient(145deg, hsl(222 47% 13%) 0%, hsl(222 47% 11%) 100%);
    --glass-bg: rgba(38, 38, 38, 0.7);
    --glass-border: rgba(255, 255, 255, 0.1);
  }
}

@layer base {
  * {
    border-color: hsl(var(--border));
  }
  body {
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
    font-feature-settings: "rlig" 1, "calt" 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  
  /* Smooth scrolling for better UX */
  html {
    scroll-behavior: smooth;
  }
  
  /* Better focus outline for accessibility - WCAG 2.1 AA */
  *:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px hsl(var(--background)), 0 0 0 4px hsl(var(--ring));
  }
  
  /* Remove default focus for mouse users */
  *:focus:not(:focus-visible) {
    outline: none;
  }

  /* Skip to main content link for accessibility */
  .skip-to-main {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 100;
    transform: translateY(-100%);
    background-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    padding: 0.5rem 1rem;
    transition: transform 0.2s;
  }
  
  .skip-to-main:focus {
    transform: translateY(0);
  }
}

@layer components {
  /* Animation utilities */
  .animate-in {
    animation: enter 200ms ease-out;
  }

  .animate-out {
    animation: exit 150ms ease-in forwards;
  }

  .fade-in {
    animation: fadeIn 200ms ease-in;
  }

  .fade-out {
    animation: fadeOut 200ms ease-out;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes exit {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(0.9);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  /* Loading spinner */
  .spinner {
    border: 2px solid hsl(var(--muted));
    border-top-color: hsl(var(--primary));
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  
  @keyframes float-up {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -150%) scale(1.5);
      opacity: 0;
    }
  }
  
  /* Opulent Glass Morphism */
  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: 
      0 8px 32px 0 rgba(0, 0, 0, 0.1),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.5);
  }
  
  /* 3D Card Transform */
  .card-3d {
    transform: translateZ(0) scale(1);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-3d:hover {
    transform: translateZ(8px) scale(1.02);
  }
  
  /* Gradient Mesh Background */
  .mesh-gradient {
    background: 
      radial-gradient(at 27% 37%, hsl(346 84% 61% / 0.3) 0px, transparent 50%),
      radial-gradient(at 97% 21%, hsl(20 91% 57% / 0.3) 0px, transparent 50%),
      radial-gradient(at 52% 99%, hsl(36 100% 60% / 0.3) 0px, transparent 50%),
      radial-gradient(at 10% 29%, hsl(349 90% 80% / 0.3) 0px, transparent 50%),
      radial-gradient(at 97% 96%, hsl(33 100% 82% / 0.3) 0px, transparent 50%);
  }
  
  /* Reduced motion support - WCAG 2.1 */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
}
