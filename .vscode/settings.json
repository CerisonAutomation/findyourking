{
    // VSCode Workspace Settings for Fyking-Men Project
    // This file contains optimized settings for a Next.js TypeScript project with Prettier, ESLint, and AI tools.
    // Organized by category for maintainability.

    // -------------------------------------------------------------------------
    // COMMENT: General Editor & UI Configuration
    // PERSPECTIVE: UI/UX Designer, Developer Experience Lead
    // RECOMMENDATION: A clean, readable, and consistent editing environment is
    // crucial for productivity. These settings optimize the visual workspace,
    // reduce clutter, and improve navigation.
    // -------------------------------------------------------------------------

    // --- Font & Typography ---
    // Using a ligature-supporting font like JetBrains Mono improves readability of code operators.
    "editor.fontFamily": "JetBrains Mono, Menlo, Monaco, Courier New, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14, // Slightly increased for better readability
    "editor.fontWeight": "normal",
    "editor.letterSpacing": 0,
    "editor.lineHeight": 1.6, // Increased line height for better separation

    // --- Cursor & Selection ---
    // Smooth caret animation provides a more polished feel.
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",

    // --- Code Readability & Navigation ---
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.minimap.enabled": true,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "breadcrumbs.enabled": true, // Shows file/symbol path at the top

    // --- Whitespace & Indentation ---
    "editor.renderWhitespace": "boundary", // Render whitespace only for selection and trailing spaces
    "editor.detectIndentation": false,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,

    // --- Accessibility & Performance ---
    "editor.accessibilitySupport": "off", // Improves performance by disabling accessibility features

    // -------------------------------------------------------------------------
    // COMMENT: Workbench & Window Layout
    // PERSPECTIVE: Minimalist, Power User
    // RECOMMENDATION: A focused workspace is key. We enable features that
    // declutter the file tree (nesting) and provide powerful command access
    // while hiding non-essential UI elements.
    // -------------------------------------------------------------------------
    "workbench.iconTheme": "material-icon-theme", // Recommended for better file-type visualization
    "workbench.layoutControl.enabled": false,
    "workbench.preferredDarkColorTheme": "Google Dark", // User preference
    "workbench.preferredLightColorTheme": "Google Light", // User preference
    "workbench.startupEditor": "none",
    "window.commandCenter": false, // Hides the title bar command center for a cleaner look
    "window.autoDetectColorScheme": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.js.map, ${capture}.d.ts",
        "*.tsx": "${capture}.js, ${capture}.js.map, ${capture}.d.ts",
        "*.js": "${capture}.js.map",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml"
    },

    // -------------------------------------------------------------------------
    // COMMENT: Performance & File Handling
    // PERSPECTIVE: Performance Engineer
    // RECOMMENDATION: Excluding large, generated, or dependency-related
    // directories from the file watcher, explorer, and search dramatically improves
    // performance, especially in large projects.
    // -------------------------------------------------------------------------
    "files.eol": "\n", // Enforce consistent line endings
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/node_modules": true, // Critical for performance
        "**/.next": true,
        "**/dist": true,
        "**/build": true,
        "**/.idx": true, // Exclude IDX-specific files
        "**/.supabase": true // Exclude Supabase-related files
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.next/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.idx/**": true,
        "**/.supabase/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/package-lock.json": true,
        "**/.next": true,
        "**/dist": true,
        "**/build": true,
        "**/.idx": true,
        "**/.supabase": true
    },

    // -------------------------------------------------------------------------
    // COMMENT: Automation & Code Quality
    // PERSPECTIVE: Automation Fanatic, Code Quality Stickler
    // RECOMMENDATION: Automate formatting and linting to maintain a consistent
    // and high-quality codebase without manual effort. This is a cornerstone
    // of enterprise-grade development.
    // -------------------------------------------------------------------------
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true, // Enable format on type for better UX
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit" // Use "explicit" for safety, can be "true"
    },
    // Set a default formatter to avoid conflicts. Prettier is the industry standard.
    "editor.defaultFormatter": "esbenp.prettier-vscode",

    // -------------------------------------------------------------------------
    // COMMENT: Language-Specific Enhancements
    // PERSPECTIVE: TypeScript Guru
    // RECOMMENDATION: Fine-tune the experience for specific languages. Inlay
    // hints for TypeScript, for example, provide valuable context directly
    // in the code, speeding up comprehension.
    // -------------------------------------------------------------------------
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.inlayHints.enabled": "on"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.inlayHints.enabled": "on"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Emmet support for JSX
    "emmet.includeLanguages": {
        "typescript": "html",
        "typescriptreact": "html"
    },

    // -------------------------------------------------------------------------
    // COMMENT: Terminal & Shell Integration
    // PERSPECTIVE: DevOps Engineer
    // RECOMMENDATION: A powerful, integrated terminal is essential. These
    // settings enable GPU acceleration for performance and use a consistent
    // font with the editor.
    // -------------------------------------------------------------------------
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontFamily": "JetBrains Mono, Menlo, Monaco, Courier New, monospace",
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.localEchoEnabled": "off", // User preference
    "terminal.integrated.localEchoLatencyThreshold": -1, // User preference
    "terminal.integrated.scrollback": 10000, // Increase scrollback for better history

    // -------------------------------------------------------------------------
    // COMMENT: Source Control (Git)
    // PERSPECTIVE: Git Expert
    // RECOMMENDATION: Enhance the built-in Git tooling. Autofetch keeps your
    // local state aware of remote changes, preventing unnecessary conflicts.
    // -------------------------------------------------------------------------
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true, // Enable smart commit for better commit messages

    // -------------------------------------------------------------------------
    // COMMENT: AI-Assisted Development (Gemini & Copilot)
    // PERSPECTIVE: AI/ML Developer
    // RECOMMENDATION: Configure AI tools for maximum efficiency. Auto-approving
    // tool usage streamlines workflows, making the AI a more seamless partner.
    // -------------------------------------------------------------------------
    "inlineChat.mode": "preview", // User preference
    "chat.tools.autoApprove": true, // User preference (Critical for my workflow)
    "github.copilot.enable": {
        "*": true,
        "yaml": false,
        "plaintext": false,
        "markdown": true
    },

    // -------------------------------------------------------------------------
    // COMMENT: TypeScript & ESLint Configuration
    // PERSPECTIVE: TypeScript Expert
    // RECOMMENDATION: Optimize TypeScript and ESLint for better development experience.
    // -------------------------------------------------------------------------
    "typescript.preferences.includePackageJsonAutoImports": "auto", // Auto-import from package.json
    "typescript.suggest.autoImports": true, // Enable auto-imports
    "eslint.workingDirectories": ["."], // Specify working directory for ESLint

    // -------------------------------------------------------------------------
    // COMMENT: Telemetry & User Settings
    // PERSPECTIVE: Project Manager (Compliance)
    // RECOMMENDATION: User-level settings for privacy and experimental features.
    // -------------------------------------------------------------------------
    "telemetry.telemetryLevel": "off" // Changed from feedback.enabled for privacy
}
