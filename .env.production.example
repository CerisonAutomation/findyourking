# ============================================================
# ZENITH DATING PLATFORM — Production Environment
# Copy to .env.production — NEVER COMMIT .env.production
# ============================================================

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Get from: supabase.com > project settings > API (production project)
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================================
# AI & LLM CONFIGURATION
# =====================================================
# OpenRouter (paid plans for production)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Production AI Services
OPENAI_API_KEY=sk-proj-your-production-openai-key
VITE_EMERGENT_LLM_KEY=your_production_emergent_llm_key
VITE_PICOVOICE_ACCESS_KEY=your_production_picovoice_access_key

# =====================================================
# P2P & WEBRTC CONFIGURATION
# =====================================================
# Trystero (room namespace — your app's unique ID)
NEXT_PUBLIC_TRYSTERO_APP_ID=zenith-dating-platform-production
NEXT_PUBLIC_TRYSTERO_STRATEGY=nostr

# Production TURN server (self-hosted or paid service)
NEXT_PUBLIC_TURN_URL=turn:your-production-turn-server:3478
TURN_USERNAME=your_production_turn_username
TURN_CREDENTIAL=your_production_turn_credential

# Production WebTorrent Tracker
WEBTORRENT_TRACKER_URL=wss://your-tracker-domain.com

# =====================================================
# MAPPING & LOCATION SERVICES
# =====================================================
# Production MapLibre / Map tiles
NEXT_PUBLIC_MAPTILER_KEY=your_production_maptiler_key

# =====================================================
# AUTHENTICATION CONFIGURATION
# =====================================================
NEXT_PUBLIC_AUTH_CALLBACK_URL=https://your-domain.com/auth/callback
NEXT_PUBLIC_MAGIC_LINK_CALLBACK_URL=https://your-domain.com/auth/callback

# =====================================================
# API CONFIGURATION
# =====================================================
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_GRAPHQL_URL=https://api.your-domain.com/graphql
NEXT_PUBLIC_WEBSOCKET_URL=wss://ws.your-domain.com

# =====================================================
# STRIPE CONFIGURATION (LIVE MODE)
# =====================================================
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_key
STRIPE_WEBHOOK_SECRET=your_production_webhook_secret

# =====================================================
# EMAIL & NOTIFICATIONS
# =====================================================
# SendGrid (production account)
SENDGRID_API_KEY=SG.your_production_sendgrid_key

# Push Notifications (Firebase Cloud Messaging - production)
NEXT_PUBLIC_FCM_VAPID_KEY=your_production_fcm_vapid_key

# =====================================================
# ANALYTICS & MONITORING
# =====================================================
# Sentry (production project)
SENTRY_DSN=your_production_sentry_dsn
NEXT_PUBLIC_SENTRY_DSN=your_production_sentry_dsn

# Google Analytics (production)
NEXT_PUBLIC_GA_ID=your_production_google_analytics_id
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# =====================================================
# FEATURE FLAGS
# =====================================================
VITE_ENABLE_AI_MATCHING=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_STORYBOOK=false
VITE_ENABLE_QUICKSHARE=true
VITE_ENABLE_VOICE_COMMANDS=true

# =====================================================
# PRODUCTION CONFIGURATION
# =====================================================
NODE_ENV=production
VITE_DEV_MODE=false
VITE_LOG_LEVEL=error
VITE_MOCK_API=false

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=Zenith Dating Platform

# =====================================================
# SECURITY & PERFORMANCE
# =====================================================
# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Session management
SESSION_SECRET=your_production_session_secret
JWT_SECRET=your_production_jwt_secret

# CDN (optional)
NEXT_PUBLIC_CDN_URL=https://cdn.your-domain.com
